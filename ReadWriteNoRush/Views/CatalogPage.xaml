<Page x:Class="ReadWriteNoRush.Views.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог книг" Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">

                <TextBox x:Name="TxtSearch" Width="220" Height="32" Padding="8,4"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtSearch_TextChanged"/>

                <ComboBox x:Name="CmbGenre" Width="140" Height="32" Margin="10,0,0,0"
                          SelectionChanged="CmbGenre_SelectionChanged"/>

                <ComboBox x:Name="CmbSort" Width="150" Height="32" Margin="10,0,0,0"
                          SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="По названию" IsSelected="True"/>
                    <ComboBoxItem Content="По оценке"/>
                </ComboBox>

            </StackPanel>
        </Border>

        <!-- Сетка книг -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="BooksPanel" Margin="16" Orientation="Horizontal"/>
        </ScrollViewer>

    </Grid>
</Page>