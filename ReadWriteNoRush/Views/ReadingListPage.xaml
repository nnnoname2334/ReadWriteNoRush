<Page x:Class="ReadWriteNoRush.Views.ReadingListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Списки книг" Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Вкладки статусов -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Button x:Name="BtnAbandoned" Content="Заброшено" Height="32"
                        Padding="14,0" Margin="0,0,6,0" Cursor="Hand"
                        Click="BtnStatus_Click" Tag="1"/>
                <Button x:Name="BtnPlanned" Content="В планах" Height="32"
                        Padding="14,0" Margin="0,0,6,0" Cursor="Hand"
                        Click="BtnStatus_Click" Tag="2"/>
                <Button x:Name="BtnReading" Content="Читаю" Height="32"
                        Padding="14,0" Margin="0,0,6,0" Cursor="Hand"
                        Click="BtnStatus_Click" Tag="3"/>
                <Button x:Name="BtnRead" Content="Прочитано" Height="32"
                        Padding="14,0" Cursor="Hand"
                        Click="BtnStatus_Click" Tag="4"/>
            </StackPanel>
        </Border>

        <!-- Фильтры -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBox x:Name="TxtSearch" Width="200" Height="30" Padding="6,4"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtSearch_TextChanged"/>
                <ComboBox x:Name="CmbGenre" Width="130" Height="30" Margin="10,0,0,0"
                          SelectionChanged="CmbGenre_SelectionChanged"/>
                <ComboBox x:Name="CmbSort" Width="140" Height="30" Margin="10,0,0,0"
                          SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="По названию" IsSelected="True"/>
                    <ComboBoxItem Content="По оценке"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Сетка книг -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="BooksPanel" Margin="16" Orientation="Horizontal"/>
        </ScrollViewer>
    </Grid>
</Page>