<Window x:Class="ReadWriteNoRush.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Введите причину" Height="180" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtPrompt" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtInput" Height="34" Padding="6"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Width="80" Height="30" Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>
            <Button Content="ОК" Width="80" Height="30"
                    Background="#4A90D9" Foreground="White" BorderThickness="0"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>