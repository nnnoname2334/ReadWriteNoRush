<Page x:Class="ReadWriteNoRush.Views.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Книга" Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="800">

            <!-- Заголовок + кнопка назад -->
            <Button x:Name="BtnBack" Content="← Назад" HorizontalAlignment="Left"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand" FontSize="13" Foreground="#4A90D9"
                    Click="BtnBack_Click" Margin="0,0,0,16"/>

            <!-- Инфо о книге -->
            <Border Background="White" CornerRadius="8" Padding="20"
                    BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Обложка -->
                    <Border Grid.Column="0" Width="120" Height="170"
                            Background="#EEE" CornerRadius="6">
                        <Image x:Name="ImgCover" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Детали -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock x:Name="TxtTitle" FontSize="20"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtAuthor" Foreground="Gray"
                                   Margin="0,6,0,0" FontSize="13"/>
                        <TextBlock x:Name="TxtGenres" Foreground="SteelBlue"
                                   Margin="0,6,0,0" FontSize="12"/>
                        <TextBlock x:Name="TxtRating" Foreground="OrangeRed"
                                   Margin="0,6,0,0" FontSize="14"/>
                        <TextBlock x:Name="TxtDesc" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Foreground="#444"/>

                        <!-- Кнопки действий -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="BtnComplainBook" Content="⚠ Жалоба на книгу"
                                    Height="30" Padding="10,0" Margin="0,0,8,0"
                                    Background="#E74C3C" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="BtnComplainBook_Click"/>
                            <Button x:Name="BtnComplainAuthor" Content="⚠ Жалоба на автора"
                                    Height="30" Padding="10,0" Margin="0,0,8,0"
                                    Background="#E67E22" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="BtnComplainAuthor_Click"/>
                            <Button x:Name="BtnFreezeBook" Content="❄ Заморозить книгу"
                                    Height="30" Padding="10,0" Visibility="Collapsed"
                                    Background="#8E44AD" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="BtnFreezeBook_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Чтение текста -->
            <!-- Чтение текста -->
            <Border Background="White" CornerRadius="8" Padding="20"
        BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,16">
                <StackPanel>
                    <Button x:Name="BtnRead" Content="📖 Читать книгу"
                Height="36" Padding="16,0" HorizontalAlignment="Left"
                Background="#4A90D9" Foreground="White"
                BorderThickness="0" Cursor="Hand"
                Click="BtnRead_Click"/>
                    <Border x:Name="PanelContent" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock x:Name="TxtContent" TextWrapping="Wrap"
                       LineHeight="22" Foreground="#333"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Оставить отзыв -->
            <Border x:Name="PanelAddReview" Background="White" CornerRadius="8"
                    Padding="20" BorderBrush="#DDD" BorderThickness="1"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Оставить отзыв" FontWeight="Bold" FontSize="15"/>
                    <TextBox x:Name="TxtReviewText" Height="70" Margin="0,10,0,0"
                             Padding="8" TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Оценка:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbRating" Width="70" Height="30">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/>
                            <ComboBoxItem Content="10" IsSelected="True"/>
                        </ComboBox>
                        <Button Content="Отправить" Height="30" Padding="14,0"
                                Margin="12,0,0,0" Background="#4A90D9"
                                Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="BtnAddReview_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Список отзывов -->
            <TextBlock Text="Отзывы" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <StackPanel x:Name="ReviewsPanel"/>

        </StackPanel>
    </ScrollViewer>
</Page>