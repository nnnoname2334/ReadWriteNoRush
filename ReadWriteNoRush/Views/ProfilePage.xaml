<Page x:Class="ReadWriteNoRush.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль" Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="700">

            <!-- Инфо о пользователе -->
            <Border Background="White" CornerRadius="8" Padding="20"
                    BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Профиль" FontSize="18"
                               FontWeight="Bold" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя:"
                                   Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtName" Grid.Row="0" Grid.Column="1"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Логин:"
                                   Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtLogin" Grid.Row="1" Grid.Column="1"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:"
                                   Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtEmail" Grid.Row="2" Grid.Column="1"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Роль:"
                                   Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtRole" Grid.Row="3" Grid.Column="1"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Заявка на роль автора -->
                    <Button x:Name="BtnApplyAuthor" Content="Подать заявку на роль Автора"
                            Height="34" Padding="14,0" Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Background="#4A90D9" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnApplyAuthor_Click"/>
                </StackPanel>
            </Border>

            <!-- Предупреждение о заморозке -->
            <Border x:Name="PanelFrozen" Background="#FDECEA" CornerRadius="8"
                    Padding="20" BorderBrush="#E74C3C" BorderThickness="1"
                    Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="❄ Ваш аккаунт заморожен" FontWeight="Bold"
                               Foreground="#E74C3C" FontSize="15"/>
                    <TextBlock x:Name="TxtFrozenReason" TextWrapping="Wrap"
                               Margin="0,8,0,12" Foreground="#555"/>
                    <Button Content="Оспорить заморозку" Height="32" Padding="14,0"
                            HorizontalAlignment="Left"
                            Background="#E74C3C" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnUnfreeze_Click"/>
                </StackPanel>
            </Border>

            <!-- Отзывы пользователя -->
            <TextBlock Text="Мои отзывы" FontSize="16"
                       FontWeight="Bold" Margin="0,0,0,10"/>
            <StackPanel x:Name="ReviewsPanel"/>

        </StackPanel>
    </ScrollViewer>
</Page>