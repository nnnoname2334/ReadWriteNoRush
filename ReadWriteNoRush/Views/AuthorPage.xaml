<Page x:Class="ReadWriteNoRush.Views.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница автора" Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="Мои книги" FontSize="16"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="+ Добавить книгу" Height="34"
                        Padding="14,0" Margin="20,0,0,0"
                        Background="#4A90D9" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnAddBook_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="800">

                <!-- Опубликованные книги -->
                <TextBlock Text="Опубликованные книги" FontSize="15"
                           FontWeight="Bold" Margin="0,0,0,12"/>
                <WrapPanel x:Name="PublishedPanel" Margin="0,0,0,24"/>

                <!-- Замороженные книги -->
                <TextBlock Text="Замороженные книги" FontSize="15"
                           FontWeight="Bold" Margin="0,0,0,12"/>
                <WrapPanel x:Name="FrozenPanel"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>