<Page x:Class="ReadWriteNoRush.Views.AddEditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Книга" Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="650">

            <Button Content="← Назад" HorizontalAlignment="Left"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#4A90D9" FontSize="13" Cursor="Hand"
                    Click="BtnBack_Click" Margin="0,0,0,16"/>

            <TextBlock x:Name="TxtPageTitle" FontSize="18"
                       FontWeight="Bold" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="8" Padding="20"
                    BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>

                    <TextBlock Text="Название" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTitle" Height="34" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Описание" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDesc" Height="70" Padding="8"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Ссылка на обложку" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCover" Height="34" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Текст книги" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtContent" Height="120" Padding="8"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Жанры" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="GenresPanel" Margin="0,0,0,16"/>

                    <Button x:Name="BtnSave" Content="Сохранить" Height="36"
                            Padding="20,0" HorizontalAlignment="Left"
                            Background="#4A90D9" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>