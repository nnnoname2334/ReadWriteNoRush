<Page x:Class="ReadWriteNoRush.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администрирование" Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Вкладки -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0">
                <Button x:Name="BtnTabComplaints" Content="Жалобы"
                        Height="32" Padding="14,0" Margin="0,0,6,0"
                        Cursor="Hand" Click="BtnTab_Click" Tag="0"/>
                <Button x:Name="BtnTabUnfreeze" Content="Разморозка"
                        Height="32" Padding="14,0" Margin="0,0,6,0"
                        Cursor="Hand" Click="BtnTab_Click" Tag="1"/>
                <Button x:Name="BtnTabRoles" Content="Роли"
                        Height="32" Padding="14,0" Margin="0,0,6,0"
                        Cursor="Hand" Click="BtnTab_Click" Tag="2"/>
                <Button x:Name="BtnTabFrozen" Content="Замороженные"
                        Height="32" Padding="14,0" Margin="0,0,6,0"
                        Cursor="Hand" Click="BtnTab_Click" Tag="3"/>
                <Button x:Name="BtnTabUsers" Content="Пользователи"
                        Height="32" Padding="14,0"
                        Cursor="Hand" Click="BtnTab_Click" Tag="4"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Margin="24" MaxWidth="900"/>
        </ScrollViewer>
    </Grid>
</Page>