<Page x:Class="ReadWriteNoRush.Views.FrozenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Аккаунт заморожен" Background="#F5F5F5">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxWidth="500">

        <Border Background="#FDECEA" CornerRadius="10" Padding="30"
                BorderBrush="#E74C3C" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="❄ Ваш аккаунт заморожен"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#E74C3C" HorizontalAlignment="Center"/>

                <TextBlock x:Name="TxtReason" TextWrapping="Wrap"
                           Margin="0,16,0,0" FontSize="13"
                           Foreground="#555" HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Text="Вы можете подать заявку на разморозку аккаунта."
                           TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="Gray" FontSize="12"
                           HorizontalAlignment="Center" TextAlignment="Center"/>

                <Button Content="Оспорить заморозку" Height="36"
                        Padding="20,0" Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Background="#E74C3C" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnUnfreeze_Click"/>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>