<Window x:Class="ReadWriteNoRush.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        MinHeight="500" MinWidth="700">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#2C2F3F">
            <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">

                <!-- Каталог -->
                <Button x:Name="BtnCatalog" Height="50" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="BtnCatalog_Click"
                        ToolTip="Каталог книг">
                    <TextBlock Text="📚" FontSize="22" HorizontalAlignment="Center"/>
                </Button>

                <!-- Списки книг -->
                <Button x:Name="BtnLists" Height="50" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="BtnLists_Click"
                        ToolTip="Списки книг">
                    <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center"/>
                </Button>

                <!-- Профиль -->
                <Button x:Name="BtnProfile" Height="50" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="BtnProfile_Click"
                        ToolTip="Профиль">
                    <TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center"/>
                </Button>

                <!-- Страница автора (только для автора) -->
                <Button x:Name="BtnAuthor" Height="50" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="BtnAuthor_Click"
                        ToolTip="Страница автора">
                    <TextBlock Text="✍️" FontSize="22" HorizontalAlignment="Center"/>
                </Button>

                <!-- Администрирование (только для админа) -->
                <Button x:Name="BtnAdmin" Height="50" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="BtnAdmin_Click"
                        ToolTip="Администрирование">
                    <TextBlock Text="⚙️" FontSize="22" HorizontalAlignment="Center"/>
                </Button>

                <!-- Заморозка (только если заморожен) -->
                <Button x:Name="BtnFrozen" Height="50" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="BtnFrozen_Click"
                        ToolTip="Аккаунт заморожен" Visibility="Collapsed">
                    <TextBlock Text="❄️" FontSize="22" HorizontalAlignment="Center"/>
                </Button>

                <!-- Выход -->
                <Button x:Name="BtnLogout" Height="50" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="BtnLogout_Click"
                        ToolTip="Выйти" Margin="0,20,0,0">
                    <TextBlock Text="🚪" FontSize="22" HorizontalAlignment="Center"/>
                </Button>

            </StackPanel>
        </Border>

        <!-- Область контента -->
        <Frame x:Name="MainFrame" Grid.Column="1"
               NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>